{
	"mcpServers": {
		"playwright": {
			"command": "mise",
			"args": ["exec", "--", "bunx", "-y", "@playwright/mcp@latest", "--browser", "chromium"]
		},
		"playwright-bentomod": {
			"command": "mise",
			"args": ["exec", "--", "bunx", "-y", "@playwright/mcp@latest", "--cdp-endpoint", "http://localhost:9223"]
		}
	}
}
