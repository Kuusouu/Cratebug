{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
	"jsPlugins": [{ "name": "cratebug", "specifier": "./lint/style-tokens.js" }],
	"options": { "typeAware": true },
	"categories": {
		"correctness": "warn",
		"nursery": "off",
		"pedantic": "off",
		"perf": "off",
		"restriction": "off",
		"style": "off",
		"suspicious": "warn"
	},
	"rules": {
		"import/no-cycle": "error",
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		"no-unused-vars": "error",
		"no-var": "error",
		"prefer-const": "error",
		"no-console": "off",
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "error",
		"react/jsx-key": "error",
		"react/react-in-jsx-scope": "off",
		"react/exhaustive-effect-dependencies": "off",
		"react/memo-dependencies": "off",
		"react/refs": "off",
		"react/set-state-in-effect": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"jsx-a11y/label-has-associated-control": ["error", { "depth": 3 }],
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/consistent-return": "off",
		"typescript/no-misused-spread": "off",
		"typescript/no-unsafe-type-assertion": "off",
		"typescript/ban-ts-comment": [
			"error",
			{
				"ts-expect-error": "allow-with-description",
				"ts-ignore": true,
				"ts-nocheck": true,
				"ts-check": false
			}
		],
		"typescript/consistent-type-definitions": ["error", "type"],
		"typescript/consistent-type-imports": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-wrapper-object-types": "error",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-useless-spread": "off"
	},
	"overrides": [
		{
			"files": ["src/**"],
			"rules": { "cratebug/no-raw-tailwind-colors": "error" }
		},
		{
			"files": ["src/**"],
			"excludeFiles": ["src/components/ui/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@base-ui/react",
									"@base-ui/react/**",
									"@radix-ui/**",
									"radix-ui"
								],
								"message": "Compose primitives from @/components/ui; keep vendor imports inside that directory."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": [
		"/node_modules",
		"/wailsjs",
		"/dist",
		"/bun.lock",
		"/*.log",
		"/.env",
		"/.env.*"
	],
	"env": {
		"browser": true,
		"node": true
	}
}
