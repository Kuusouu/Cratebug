{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"sortTailwindcss": {
		"stylesheet": "./src/tailwind.css",
		"functions": ["cn", "clsx", "cva"]
	},
	"ignorePatterns": ["node_modules", "wailsjs", "dist", "bun.lock", "*.log", ".env", ".env.*"]
}
